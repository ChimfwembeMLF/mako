# Copy to .env (or set in Expo) — never commit real secrets.
# Production (default for real devices / TestFlight):
EXPO_PUBLIC_API_URL=https://mako.tekreminnovations.com
#
# Local dev — uncomment instead:
# EXPO_PUBLIC_API_URL=http://localhost:4000
# Physical device against local API: use LAN IP, e.g. http://192.168.100.26:4000

# Google sign-in — same OAuth project as api GOOGLE_CLIENT_ID / web client (client/src uses server redirect).
# Expo Web and native use /api/v1/auth/google/mobile (redirect URI stays on the API, not localhost:8081).
# Copy the Web application Client ID from api/.env GOOGLE_CLIENT_ID:
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional: native expo-auth-session client ids (only if not using server redirect flow)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
