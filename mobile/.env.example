# Copy to .env (or set in Expo) — never commit real secrets.
# Physical devices need your machine LAN IP, not localhost.

EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth (public client IDs only)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
