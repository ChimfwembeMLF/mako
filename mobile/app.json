{
  "expo": {
    "name": "Mako",
    "slug": "mako",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-padded.png",
    "scheme": "mako",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-padded.png",
      "bundleIdentifier": "com.tekrem.mako",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tekrem.mako",
      "adaptiveIcon": {
        "backgroundColor": "#e8ebe6",
        "foregroundImage": "./assets/images/icon-padded.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/icon-padded.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "mako"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e8ebe6",
          "image": "./assets/images/icon-padded.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-image-picker",
      "expo-notifications",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsMovieWithMaxCount": 1
          },
          "androidIntentFilters": ["text/*", "image/*", "video/*"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mako to access your camera to capture photos for posts."
        }
      ],
      [
        "react-native-widget-extension",
        {
          "widgetsFolder": "widgets",
          "deploymentTarget": "16.2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ab86a0f-8813-4363-8063-ffb3810848e5"
      }
    },
    "owner": "thecodefathas-team"
  }
}
